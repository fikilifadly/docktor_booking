# Backend Environment Variables Example
# This is an example file - copy to .env and update values
# 
# For the scope of this exercise, all variables are configured in docker-compose.yml
# and automatically available to the backend container.
#
# For production deployment:
# 1. Copy this file to .env
# 2. Update values with production credentials
# 3. Use environment variable injection onto the orchestrator and secrets management
# 4. In production settings, I would avoid include .env files to the commit

# Main Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/appointment_db

# Test Database   
TEST_DATABASE_URL=postgresql://postgres:postgres@postgres-test:5432/appointment_test_db

# Database Connection Details
POSTGRES_DB=appointment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Test Database Connection Details
POSTGRES_TEST_DB=appointment_test_db
POSTGRES_TEST_USER=postgres
POSTGRES_TEST_PASSWORD=postgres

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_CONFIG_SERVER_MODE=False

# JWT Config
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_MIN=60

# Python Path
PYTHONPATH=/app

# Timezone
TZ=Asia/Jakarta
