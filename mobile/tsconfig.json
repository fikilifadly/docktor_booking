{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,                   // Mengaktifkan semua pengecekan ketat
    "noImplicitAny": true,            // Error jika ada variabel yang tipenya 'any' secara tidak sengaja
    "strictNullChecks": true,         // Error jika potensi variabel null tidak ditangani
    "noUnusedLocals": true,           // Error jika ada variabel yang dibuat tapi tidak dipakai
    "noUnusedParameters": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
